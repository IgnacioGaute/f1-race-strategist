# Copy to backend/.env for local development. Local-only values, no real secrets.
PORT=4000
# Comma-separated list of origins allowed to call this API (the Next.js dev server).
CORS_ORIGINS=http://localhost:3000

F1_API_BASE_URL=https://tech-challenge101.onrender.com
# Total budget per provider query, including the single retry and its wait (1000-80000).
# The provider sleeps when idle and can take up to ~1 minute to wake up.
F1_API_TIMEOUT_MS=60000

# Must match docker-compose.yml (host port 5434 avoids clashing with a local PostgreSQL).
DB_HOST=localhost
DB_PORT=5434
DB_USER=f1
DB_PASSWORD=f1_local_dev
DB_NAME=f1_strategist
